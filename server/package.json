{
  "name": "cardiovest-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "imports": {
    "#api": "./lib/api.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning main.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch main.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "alat": "node --disable-warning=ExperimentalWarning lib/alat.js"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.2",
    "mqtt": "5.10.3",
    "nodemailer": "6.9.16",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.1"
  }
}
