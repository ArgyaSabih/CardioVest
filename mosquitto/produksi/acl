# ACL Mosquitto. Akun perangkat = DEVICE_ID-nya (mis. cv-001), jadi %u = device id.
# Perangkat hanya boleh mengirim data mentahnya sendiri dan membaca perintah untuk dirinya;
# state/alert/inference hanya boleh ditulis layanan cloud, supaya alat yang dibobol tidak bisa
# memalsukan alarm milik pengguna lain.

pattern write device/%u/ecg
pattern write device/%u/vital
pattern write device/%u/event
pattern write device/%u/lwt
pattern read  device/%u/cmd
pattern read  device/%u/state
# simulator yang login dengan akun perangkat (demo di server)
pattern readwrite sim/%u/#

# layanan cloud (cloud/): membaca semua perangkat, menulis state/alert/cmd/inference
user cloud
topic readwrite device/#

# gateway web / dashboard keluarga: membaca semua, dan hanya boleh menulis permintaan reset alarm
# (device/+/remote); keputusan melepas CRITICAL tetap diambil layanan cloud (REMOTE_RESET)
user web
topic read device/#
topic write device/+/remote
