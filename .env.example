# Salin menjadi .env lalu ubah sesuai kebutuhan (docker compose membacanya otomatis)
DEVICE_ID=cv-001
USER_ID=user-001
# skenario awal simulator: normal | artefak | pra_serangan | pra_af | serangan | serangan_jatuh | serangan_vt | sqi_rendah | putus_koneksi
SCENARIO=normal
# format payload ECG: json | binary (delta-encoding)
PAYLOAD_FORMAT=json
# sumber ECG simulator: replay (rekaman asli PTB-XL/MIT-BIH pasien set uji) | synthetic (generator)
ECG_SOURCE=replay
# 1 = hanya window yang diklasifikasikan benar dengan p_conf >= TAU_CONF (demo deterministik)
# 0 = seluruh window held-out (lebih realistis, termasuk kesalahan model)
REPLAY_ONLY_CORRECT=1
# p_conf minimum window demo (mode 1); diberi margin di atas TAU_CONF agar demo deterministik
REPLAY_MIN_CONF=0.60

# Port debug viewer di Windows (http://localhost:<port>)
VIEWER_PORT=8251

# Parameter decision engine (BAB 4.5 / 5.5)
# 0.44 = hasil kalibrasi pada set validasi (README 6.3); 0.50 = alternatif lebih konservatif
TAU_CONF=0.44
TAU_WARN=0.80
# tau adaptif gerak: dipakai bila simpangan baku |a| (median 7 s) > MOTION_SD_G (README 6.3)
TAU_CONF_MOTION=0.76
MOTION_SD_G=0.08
PERSIST_N=2
PERSIST_N_DEGRADED=3
# persistence khusus kelas Pra-Serangan; 0 = sama dengan PERSIST_N. Tentukan dari data alat sendiri:
#   python tools/kalibrasi_lapangan.py --db <cloud-data>/cardiovest.db
PERSIST_N_PRE=0

# Retensi data mentah ECG/vital (hari). 0 = simpan semua. Bila diisi minimal 30 (F-BE-4).
# ECG 250 Hz memakan kira-kira 45-60 MB per alat per hari di SQLite. Event dan ECG di sekitarnya tidak dihapus.
RETENSI_HARI=0
HYSTERESIS_M=1
HR_HIGH=120
HR_LOW=40
GSR_ABS_HIGH=20
GSR_K=2.5
CALIB_SECONDS=30
TAU_SQI=0.5

# Lokasi GPS simulasi (sekitar DTETI FT UGM)
GPS_LAT=-7.765500
GPS_LON=110.371900

# Notifikasi mock: peluang gagal FCM (uji retry backoff), kontak darurat (JSON)
FCM_MOCK_FAIL_RATE=0
CONTACTS_JSON=

# ============================================================== Aplikasi CardioVest (folder web/)
# Buka http://localhost:8252 setelah `docker compose up -d --build`.
WEB_PORT=8252
# Alat yang boleh dipasangkan: ID sama dengan DEVICE_ID di atas dan di firmware, lalu kode 6 digit.
# Kode kosong ("cv-001:") = dibuat acak dan dicetak sekali di `docker compose logs web`.
# Label QR: docker compose exec web npm run alat -- kode-baru cv-001
DEVICES=cv-001:
# Email verifikasi & reset kata sandi. Kosong = isi email dicetak ke log (cukup untuk uji di laptop).
# Gmail: pakai "sandi aplikasi", bukan sandi akun: smtps://akun%40gmail.com:sandiaplikasi@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=CardioVest <no-reply@cardiovest.local>
# Alamat publik aplikasi (tautan di email/notifikasi). Kosong = http://localhost:WEB_PORT
PUBLIC_URL=

# ============================================================== Hanya untuk server internet (produksi)
# WEB_DOMAIN=cardiovest.contoh.id
# MQTT_PASS_CLOUD=        # dari mosquitto/produksi/buat_akun.sh
# MQTT_PASS_WEB=

# ============================================================== Hanya bila tampilan dipasang di Vercel
# Lihat web/README.md bagian Vercel. VPS tetap menjalankan semuanya; Vercel menyajikan halaman.
# PUBLIC_URL di atas diisi alamat Vercel, misalnya https://cardiovest.vercel.app
# ALLOWED_ORIGINS=https://cardiovest.vercel.app
# PROXY_SECRET=           # string acak panjang, sama persis dengan di Vercel
